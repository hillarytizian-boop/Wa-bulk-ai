# ---- Branding ------------------------------------------------------------
SITE_NAME=My SMM Panel
PUBLIC_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ---- Security ------------------------------------------------------------
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Set to true when the site is served over HTTPS (required in production)
COOKIE_SECURE=false
# Set to true behind a reverse proxy / CDN so rate limits see real client IPs
TRUST_PROXY=false
# Session lifetime in days
SESSION_DAYS=14
# Limit credential attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20
# Allow the site to be embedded in an iframe (true in dev for previews, false in production)
ALLOW_IFRAME=false

# ---- Database ------------------------------------------------------------
# Postgres (Supabase) in production. When DATABASE_URL is set the SQLite driver is not used.
# Supabase: Dashboard -> Project Settings -> Database -> Connection pooling (port 6543).
DATABASE_URL=
# Optional: extra candidates tried if the first cannot connect (comma separated)
DATABASE_FALLBACK_URLS=
# Local development without Postgres falls back to this SQLite file:
DATABASE_PATH=./data/store.db

# ---- smm.africa provider (server-side only, never exposed to the browser) -
SMM_API_URL=https://smm.africa/api/v3
SMM_API_KEY=
SMM_TIMEOUT_MS=60000
SMM_RETRY_BASE_MS=2000

# ---- Pricing (defaults; both editable later in the Admin panel) ----------
# 0.30 = +30% on the provider rate
DEFAULT_MARKUP=0.30
# KES per 1 USD, used to convert provider USD rates into KES
KES_PER_USD=129
# Fixed fee added to every price, in KES
FEE_KES=50

# ---- First admin account ------------------------------------------------
# Created only if no user with this email exists. NEVER commit a real .env:
# .env is gitignored - keep the password there (or rotate it with
# `npm run admin:password`) and change it after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ---- M-Pesa (Safaricom Daraja) ------------------------------------------
# Leave MPESA_CONSUMER_KEY empty to disable M-Pesa top-ups entirely.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerBuyGoodsOnline for a Till number, CustomerPayBillOnline for a Paybill
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_PARTYB=
# Only for tests / self-hosted mocks (defaults to Safaricom's sandbox/live host)
# MPESA_BASE_URL=

# ---- Vercel cron ---------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/tick
CRON_SECRET=

# ---- Wallet limits (KES) -------------------------------------------------
MIN_TOPUP_KES=50
MAX_TOPUP_KES=150000
