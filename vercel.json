{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.js" }],
  "crons": [{ "path": "/api/cron/tick", "schedule": "15 2 * * *" }]
}
